# Copy to .env and fill in. Never commit the real .env.

# Reusable Tailscale auth key from https://login.tailscale.com/admin/settings/keys
# (must be reusable, not single-use — the container restarts during development)
TAILSCALE_AUTH_KEY=
TAILSCALE_HOSTNAME=agent-relay-even-g2

# hermes | lm_studio  (lm_studio really means "any OpenAI-compatible
# /v1/chat/completions endpoint" — LM Studio, Ollama, and similar all work)
BACKEND=hermes

# Hermes (or Hermes-compatible) backend — your own instance's tailnet address.
HERMES_BASE_URL=http://<your-hermes-host>.<your-tailnet>.ts.net:8642
HERMES_API_KEY=

# LM Studio / Ollama / any OpenAI-compatible server — only needed if
# BACKEND=lm_studio. Example: LM Studio's own default port is 1234; Ollama's
# OpenAI-compatible API is on its normal port, 11434, same /v1/chat/completions
# path either way. LM_STUDIO_MODEL is optional for a server with one loaded model.
LM_STUDIO_BASE_URL=
LM_STUDIO_MODEL=

# Your STT service — see gateway/stt_client.py for the request/response
# shape it expects; edit that file if yours differs (e.g. not qwen3/en).
SOGNI_BASE_URL=http://<your-stt-host>.<your-tailnet>.ts.net:5001
SOGNI_STT_PATH=/transcribe
SOGNI_API_KEY=
SOGNI_ENGINE=qwen3
SOGNI_LANGUAGE=en
